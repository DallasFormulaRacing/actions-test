# Stage 1: Build (VITE_API_URL baked in at build time)
FROM node:20-slim AS build
WORKDIR /app

# Install dependencies first ("layer caching"??)
COPY frontend/package*.json ./
RUN npm ci

# Copy source
COPY frontend/ .

# Make the API URL available to Vite at build time
ARG VITE_API_URL=http://car-sensor-api
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Stage 2: Listen for browser request and hand over files ("serving"?)
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]